# Discord bot token from the Developer Portal. Required.
DISCORD_BOT_TOKEN=

# anthropic | gemini. Required.
LLM_PROVIDER=anthropic

# API key for the selected provider. Required.
LLM_API_KEY=

# Optional. Defaults: claude-opus-5 (anthropic), gemini-2.5-pro (gemini).
# LLM_MODEL=

# Optional. Cheaper model for the stage-one intent gate. Defaults to LLM_MODEL.
# LLM_GATE_MODEL=claude-haiku-4-5

# Private channel for white cell audit embeds. Required.
WHITE_CELL_CHANNEL_ID=

# Optional. Comma-separated allowlist. Empty means any channel.
# ALLOWED_CHANNEL_IDS=

# Optional. Hold every ruling for white cell approval (react ✅/❌) before the
# blue team sees it. Defaults to false.
# HUMAN_IN_THE_LOOP=false

# Optional. Reply sent to the asker when the white cell denies a held ruling
# (human in the loop). Blank uses the built-in wording:
#   That request has been denied to retain range integrity.
# Keep it generic: it must not hint at what the change would have touched.
# HITL_DENIED_TEXT=

# Optional. Where Range.md and resources/ live. Defaults to the working directory.
# RANGE_DIR=.

# Optional. Free-text guidance for the AI when it rules on a change: exercise
# windows, scope decisions, standing calls the range document cannot express.
# It cannot relax the non-disclosure rules - those are restated after it.
# Multi-line values must be quoted, which the GUI does for you.
EXTRA_INSTRUCTIONS=
